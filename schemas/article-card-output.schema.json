{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "article-card-output.schema.json",
  "title": "ArticleCardResult",
  "type": "object",
  "required": ["skill", "skillVersion", "template", "deck", "render", "warnings"],
  "properties": {
    "skill": { "const": "article_card_composer" },
    "skillVersion": { "type": "string" },
    "template": {
      "type": "object",
      "required": ["id", "version", "fingerprint", "displayName", "fingerprintAlgorithm"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "displayName": { "type": "string" },
        "fingerprintAlgorithm": { "const": "card-template-canonical-v1" }
      }
    },
    "deck": {
      "type": "object",
      "required": ["deckTitle", "pages"],
      "properties": {
        "deckTitle": { "type": "string", "minLength": 1 },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "layout", "headline", "items"],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "layout": {
                "enum": ["headline-list", "numbered-grid", "statement", "steps", "comparison"]
              },
              "eyebrow": { "type": ["string", "null"] },
              "headline": { "type": "string" },
              "subheadline": { "type": ["string", "null"] },
              "items": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": ["title"],
                  "properties": {
                    "number": { "type": ["string", "null"] },
                    "title": { "type": "string" },
                    "body": { "type": ["string", "null"] },
                    "emphasis": { "type": ["string", "null"] }
                  }
                }
              },
              "summary": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "required": ["width", "height", "pageCount", "pageSelector", "html", "renderFingerprint"],
      "properties": {
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "pageCount": { "type": "integer" },
        "pageSelector": { "const": ".card-page" },
        "html": { "type": "string" },
        "renderFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
